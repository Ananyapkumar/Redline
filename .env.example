# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Model provider -------------------------------------------------------
GEMINI_API_KEY=

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml. Host port is 5433 to avoid colliding with a
# local Postgres on the default 5432.
DATABASE_URL=postgresql://redline:redline_local_dev@localhost:5433/redline

# --- Run limits (see ADR-001 D6) -----------------------------------------
# Abort a run that exceeds this spend, in USD. Prevents a runaway agent loop.
MAX_COST_PER_RUN_USD=0.50
# Hard wall-clock ceiling for a single run, in seconds.
RUN_TIMEOUT_SECONDS=120
# Maximum agent iterations before the run is failed and dead-lettered.
MAX_AGENT_STEPS=12
